{
  "name": "not-a-wrapper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --names \"next,convex\" -c \"cyan,magenta\" \"next dev\" \"convex dev\"",
    "dev:clean": "rm -rf .next && bun run dev",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "bun run convex:deploy",
    "build:next": "next build",
    "convex:schema-guard": "node scripts/convex-schema-contract-guard.mjs --fetch-base",
    "convex:schema-preflight": "node scripts/convex-schema-contract-preflight.mjs --fetch-base --prod --require-diff-base",
    "convex:schema-preflight:dry-run": "node scripts/convex-schema-contract-preflight.mjs --fetch-base --require-diff-base --dry-run",
    "convex:deploy": "node scripts/convex-deploy.mjs",
    "env:check": "node scripts/validate-env.mjs .env.local",
    "start": "next start",
    "lint": "eslint .",
    "smoke:openrouter": "bun scripts/smoke-openrouter.ts",
    "catalog:openrouter": "bun scripts/generate-openrouter-catalog.ts",
    "catalog:openrouter:refresh": "bun scripts/generate-openrouter-catalog.ts --fetch",
    "catalog:openrouter:check": "bun scripts/generate-openrouter-catalog.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/mcp": "2.0.7",
    "@ai-sdk/mistral": "4",
    "@ai-sdk/openai": "^4.0.7",
    "@ai-sdk/perplexity": "4",
    "@ai-sdk/provider": "^4.0.2",
    "@ai-sdk/provider-utils": "^5.0.5",
    "@ai-sdk/react": "^4.0.16",
    "@ai-sdk/xai": "4",
    "@base-ui/react": "^1.6.0",
    "@convex-dev/agent": "0.6.4",
    "@convex-dev/workos-authkit": "^0.2.7",
    "@hookform/resolvers": "^5.4.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@remixicon/react": "^4.9.0",
    "@sentry/nextjs": "^10.63.0",
    "@tanstack/react-query": "^5.101.2",
    "@workos-inc/authkit-nextjs": "^4.2.0",
    "@workos-inc/authkit-react": "^0.16.1",
    "@workos-inc/node": "^10.7.0",
    "ai": "^7.0.15",
    "braintrust": "^3.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "convex-helpers": "0.1.120",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.11",
    "embla-carousel-react": "^8.6.0",
    "exa-js": "^2.16.0",
    "file-type": "^22.0.1",
    "idb-keyval": "^6.2.6",
    "input-otp": "^1.4.2",
    "jsdom": "^29.1.1",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.16",
    "posthog-js": "^1.396.6",
    "posthog-node": "^5.39.4",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "react-use-measure": "^2.1.7",
    "recharts": "3.9.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.3.1",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "vaul-base": "^1.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
