{
  "name": "not-a-wrapper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "concurrently --names \"next,convex\" -c \"cyan,magenta\" \"next dev\" \"convex dev\"",
    "dev:clean": "rm -rf .next && bun run dev",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "bun run convex:deploy",
    "build:next": "next build",
    "convex:schema-guard": "node scripts/convex-schema-contract-guard.mjs --fetch-base",
    "convex:schema-preflight": "node scripts/convex-schema-contract-preflight.mjs --fetch-base --prod --require-diff-base",
    "convex:schema-preflight:dry-run": "node scripts/convex-schema-contract-preflight.mjs --fetch-base --require-diff-base --dry-run",
    "convex:deploy": "node scripts/convex-deploy.mjs",
    "env:check": "node scripts/validate-env.mjs .env.local",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/mcp": "2.0.7",
    "@ai-sdk/mistral": "4",
    "@ai-sdk/openai": "^4.0.7",
    "@ai-sdk/perplexity": "4",
    "@ai-sdk/provider": "^4.0.2",
    "@ai-sdk/provider-utils": "^5.0.5",
    "@ai-sdk/react": "^4.0.16",
    "@ai-sdk/xai": "4",
    "@base-ui/react": "^1.1.0",
    "@convex-dev/agent": "0.6.4",
    "@convex-dev/workos-authkit": "^0.2.5",
    "@hookform/resolvers": "^5.2.2",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@remixicon/react": "^4.9.0",
    "@sentry/nextjs": "^10.63.0",
    "@tanstack/react-query": "^5.90.20",
    "@workos-inc/authkit-nextjs": "^4.1.0",
    "@workos-inc/authkit-react": "^0.16.1",
    "@workos-inc/node": "^9.3.0",
    "ai": "^7.0.15",
    "braintrust": "^3.20.0",
    "class-variance-authority": "^0.7.1",
    "claude-code": "^1.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.39.1",
    "convex-helpers": "0.1.118",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.5",
    "embla-carousel-react": "^8.6.0",
    "exa-js": "^1.6.13",
    "file-type": "^20.4.1",
    "idb-keyval": "^6.2.1",
    "input-otp": "^1.4.2",
    "input-otp-react": "^1.0.1",
    "jsdom": "^26.0.0",
    "motion": "^12.29.2",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "posthog-js": "^1.336.4",
    "posthog-node": "^5.24.9",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.5.8",
    "react-use-measure": "^2.1.7",
    "recharts": "2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^3.22.0",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "use-stick-to-bottom": "^1.1.2",
    "vaul-base": "^1.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@next/bundle-analyzer": "^16",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
