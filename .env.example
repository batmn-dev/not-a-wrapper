# =============================================================================
# Not A Wrapper Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in local values.
# Never commit .env.local or real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# WorkOS AuthKit, used by Next.js
# -----------------------------------------------------------------------------
# Required in local .env.local and Vercel.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Required in local .env.local and Vercel.
# Must be at least 32 characters.
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Required in local .env.local and Vercel.
# Must exactly match the WorkOS callback URL.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# -----------------------------------------------------------------------------
# Convex Database
# -----------------------------------------------------------------------------
# Local only. Created by `bunx convex dev`.
CONVEX_DEPLOYMENT=

# Local only. Browser-facing Convex URL.
# In Vercel, this should be injected by:
# bun run convex:deploy
NEXT_PUBLIC_CONVEX_URL=

# -----------------------------------------------------------------------------
# Convex env variables, set with `bunx convex env set`
# -----------------------------------------------------------------------------
# These are not read from local .env.local by Convex functions.
# Set them on the target Convex deployment.
#
# bunx convex env set WORKOS_CLIENT_ID <client_id>
# bunx convex env set WORKOS_API_KEY <api_key>
# bunx convex env set WORKOS_WEBHOOK_SECRET <secret>
# bunx convex env set CHAT_ADMISSION_SECRET <same_value_as_below>
WORKOS_WEBHOOK_SECRET=

# Only set this in Convex env if WorkOS actions are added later.
# bunx convex env set WORKOS_ACTION_SECRET <secret>
WORKOS_ACTION_SECRET=

# -----------------------------------------------------------------------------
# Vercel-only deployment variables
# -----------------------------------------------------------------------------
# Required in Vercel for preview and production Convex deploys.
# Do not put this in client code.
CONVEX_DEPLOY_KEY=

# Required for production schema preflight queries.
# Use a separate Convex deploy key with deployment:functions:runTestQuery.
CONVEX_SCHEMA_PREFLIGHT_DEPLOY_KEY=

# Vercel automatically provides VERCEL_BRANCH_URL and
# VERCEL_PROJECT_PRODUCTION_URL for convex.json AuthKit configuration.
# GitHub Actions production deploys must define VERCEL_PROJECT_PRODUCTION_URL
# as a repository variable because they do not run inside Vercel.
# Use host only, without https:// or a path.
VERCEL_PROJECT_PRODUCTION_URL=

# -----------------------------------------------------------------------------
# App security
# -----------------------------------------------------------------------------
# Required locally and in Vercel.
# Generate with: openssl rand -base64 32
CSRF_SECRET=

# Required locally and in Vercel, and must be set to the same value in Convex.
# Authenticates server-resolved chat admission facts before Convex persists them.
# Generate with: openssl rand -base64 32
CHAT_ADMISSION_SECRET=

# Required locally and in Vercel.
# Must be base64 and decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
# Do not rotate after users have saved API keys unless encrypted values migrate.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AI provider keys
# -----------------------------------------------------------------------------
# At least one provider key is required to use hosted models without BYOK.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Set to "false" to disable the token-efficient-tools beta header for Anthropic.
# ANTHROPIC_TOKEN_EFFICIENT_TOOLS=false

# -----------------------------------------------------------------------------
# Optional analytics/observability
# -----------------------------------------------------------------------------
# Official deployment flag enables product analytics surfaces.
# NAW_OFFICIAL=true

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# PostHog LLM Analytics, server-side.
# phc_your_project_api_key
POSTHOG_API_KEY=

# PostHog Client Analytics, public page-view key and host.
# phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# PostHog host for server-side analytics.
# https://us.i.posthog.com
POSTHOG_HOST=

# Braintrust AI observability.
# Disabled when BRAINTRUST_API_KEY is empty. Content logging is off by default.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=not-a-wrapper
BRAINTRUST_API_URL=
BRAINTRUST_ENABLED=
BRAINTRUST_LOG_CONTENT=false

# -----------------------------------------------------------------------------
# Optional third-party tools
# -----------------------------------------------------------------------------
# These enable additional tool capabilities for models without native tools.
# Users can also provide their own keys via Settings -> Tool Keys.
EXA_API_KEY=
FIRECRAWL_API_KEY=
